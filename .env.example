# Copy to .env (gitignored) and fill in real values.

# Absolute path of the vault on the Docker host, i.e. the folder that contains
# your notes. Mounted read-only.
VAULT_DIR=/path/to/your/vault

# uid:gid the container runs as. It must be able to read the vault.
PUID=1000
PGID=1000

# Host port to publish; point your reverse proxy here.
PUBLISH_PORT=8080

# Optional: how often to rescan the vault (minimum 1s).
# SCAN_INTERVAL=5s

# Optional: the "Created / Updated" line under each note's title.
# SHOW_DATES=true

# Optional: time zone for those dates (default UTC), e.g. Europe/London.
# TZ=UTC
